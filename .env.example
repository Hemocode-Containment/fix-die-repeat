# fix-die-repeat Configuration Example
# Copy this file to .env and customize as needed

# Check command to run
FDR_CHECK_CMD=./scripts/ci.sh

# Maximum loop iterations
FDR_MAX_ITERS=10

# Antigravity CLI binary
FDR_AGY_BIN=agy

# Override model selection across all roles (e.g., claude-opus-4-6-thinking)
# FDR_MODEL=claude-opus-4-6-thinking

# Per-role ordered fallback chains
# FDR_MODELS_FIX=claude-opus-4-6-thinking,claude-sonnet-4-6-thinking,gemini-3.1-pro-high,gemini-3-flash,gpt-oss-120b-medium
# FDR_MODELS_REVIEW=claude-opus-4-6-thinking,gemini-3.1-pro-high,claude-sonnet-4-6-thinking,gemini-3-flash,gpt-oss-120b-medium
# FDR_MODELS_INTROSPECT=gemini-3.1-pro-low,gemini-3-flash,claude-sonnet-4-6,gpt-oss-120b-medium
# FDR_MODELS_IMPROVE_PROMPTS=claude-opus-4-6-thinking,gemini-3.1-pro-high,claude-sonnet-4-6-thinking

# Quota-aware model ranking via codexbar ("auto" or "none")
FDR_QUOTA_SOURCE=auto
FDR_QUOTA_MAX_USED_PCT=95.0
FDR_QUOTA_COOLDOWN_MINUTES=30

# Daily agent call cap across all roles (0 = unlimited)
FDR_DAILY_MAX_CALLS=50

# Agent execution timeouts (seconds)
FDR_AGENT_IDLE_TIMEOUT_S=120
FDR_AGENT_TOOL_TIMEOUT_S=1200
FDR_AGENT_HARD_TIMEOUT_S=3600

# Maximum PR threads to process per iteration
FDR_MAX_PR_THREADS=5

# Archive existing artifacts to a timestamped folder
FDR_ARCHIVE_ARTIFACTS=0

# Automatically compact large artifacts
FDR_COMPACT_ARTIFACTS=1

# Enable PR review mode
FDR_PR_REVIEW=0

# Enable debug mode
FDR_DEBUG=0

# Enable ntfy notifications
FDR_NTFY_ENABLED=1

# ntfy server URL
FDR_NTFY_URL=http://localhost:2586
